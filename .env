# Build settings (no secrets here — the FTP password lives in .env.deploy).
#
# Keep the webpack runtime out of index.html as an inline <script>, so the
# site's Content-Security-Policy can disallow inline scripts.
INLINE_RUNTIME_CHUNK=false
# Don't publish source maps to the live site (smaller deploys, and the
# original source isn't exposed to visitors).
GENERATE_SOURCEMAP=false
