# Restorative Care HHS — routing for Apache (Hostinger)
#
# Each page is prerendered to its own file (services.html, veterans.html, ...)
# by scripts/prerender.js, and the rules below serve /services from
# services.html and so on. The React app takes over in the browser from
# there. Any URL that isn't a real file or page gets a genuine 404 status and
# the branded 404.html, rather than index.html with a 200.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories as-is (JS/CSS/images/etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Pages written by scripts/prerender.js (services.html, veterans.html, ...)
  # carry each page's own title, description, canonical URL and share tags.
  # Serve /services (or /services/) from services.html so crawlers and link
  # previews see them. Real files and folders were already served above.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Anything else isn't a page on this site. Answer with a real 404 status
  # (instead of serving index.html with 200, which search engines treat as a
  # "soft 404") and show the branded page from build/404.html via the
  # ErrorDocument below. Every real page is prerendered to its own .html file
  # above, so no URL needs the index.html fallback any more.
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

# Cache hashed static assets aggressively; never cache index.html so
# visitors always get the build that matches the current asset hashes
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
