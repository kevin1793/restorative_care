{
  "name": "restorative_care",
  "homepage": "https://restorativecarehhs.com/",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "d3-fetch": "^3.0.1",
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.9.4",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "deploy": "npm run build && node scripts/deploy.js && node scripts/verify-live.js",
    "deploy:only": "node scripts/deploy.js",
    "deploy:setup": "node scripts/setup-deploy.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postbuild": "node scripts/prerender.js",
    "build:county-data": "node scripts/build-county-data.js",
    "verify:live": "node scripts/verify-live.js",
    "lint": "eslint src"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "basic-ftp": "^6.2.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "topojson-client": "^3.1.0"
  }
}
